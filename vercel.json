{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "toolkit.ps1"
    }
  },
  "rewrites": [
    {
      "source": "/i",
      "destination": "/api/i.js"
    },
    {
      "source": "/raw",
      "destination": "/api/i.js"
    },
    {
      "source": "/info",
      "destination": "/api/index.js"
    }
  ]
}
